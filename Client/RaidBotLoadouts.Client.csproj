<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Version>1.1.0</Version>
    <Nullable>enable</Nullable>
    <GameManaged>$(SptRoot)/EscapeFromTarkov_Data/Managed</GameManaged>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Shared/LoadoutProtocol.cs" Link="LoadoutProtocol.cs" />
    <Reference Include="Assembly-CSharp;Newtonsoft.Json;Sirenix.Serialization;UnityEngine;UnityEngine.CoreModule;UnityEngine.IMGUIModule;UnityEngine.InputLegacyModule;UnityEngine.UIModule">
      <HintPath>$(GameManaged)/%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony;BepInEx">
      <HintPath>$(SptRoot)/BepInEx/core/%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="spt-common">
      <HintPath>$(SptRoot)/BepInEx/plugins/spt/%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
